# สำหรับรันทดสอบฐานข้อมูลจริงในเครื่องทันที (Persistent Database File)
DATABASE_URL="file:./dev.db"

# หากต้องการเชื่อม PostgreSQL จริง (เช่น Supabase, Neon, หรือ Local Postgres)
# ให้เปลี่ยน provider ใน prisma/schema.prisma เป็น "postgresql" และใช้ URL ด้านล่างแทน:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/crma_delivery?schema=public"
